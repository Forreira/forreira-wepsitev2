PORT=3000
DATABASE_URL=postgresql://forreira:forreira@localhost:5432/forreira
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@forreira.com
ADMIN_PASSWORD=change-me-now
# true = create/update tables automatically (fine for local/demo). Use migrations in real production.
DB_SYNCHRONIZE=true
# Set to false to skip creating the demo shipment FOR12345678
SEED_DEMO=true
# Set to true only when the site is served over HTTPS
FORCE_HTTPS=false
